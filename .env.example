# 이 파일을 복사해서 .env 로 만들고 값을 채워넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있어서 git 에 올라가지 않습니다.

# Notion integration 토큰 (https://www.notion.so/my-integrations 에서 발급, "ntn_" 으로 시작)
NOTION_TOKEN=

# 회의 database ID.
# 노션에서 DB를 페이지로 열면 URL이 이렇게 생겼습니다:
#   https://www.notion.so/myworkspace/2a1b3c4d5e6f7g8h9i0j1k2l3m4n5o6p?v=...
#                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 이 32자리가 database ID
NOTION_DATABASE_ID=
